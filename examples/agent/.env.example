# Optional — run the agent on a REAL open-source model (Llama via Groq), on your
# own budget. Get a free key at https://console.groq.com/keys
# Without it, a scripted brain keeps the demo working with zero setup.
GROQ_API_KEY=

# The Capline coordinator that enforces the mandate. Defaults to the hosted one,
# so this demo needs NO on-chain funds. Point at your own to self-host.
CAPLINE_COORDINATOR_URL=https://capline-protocol.vercel.app/api/coordinator
