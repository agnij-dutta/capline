{
  "name": "capline-mcp",
  "version": "0.2.0",
  "description": "MCP server that gives an AI agent a wallet it can't drain \u2014 it can only pay within a signed Capline mandate (per-tx cap, payee allowlist, global cross-chain cap).",
  "type": "module",
  "license": "MIT",
  "author": "Agnij Dutta (https://x.com/0xholmesdev)",
  "homepage": "https://capline-protocol.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/agnij-dutta/capline",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agent-payments",
    "x402",
    "ap2",
    "spending-limits",
    "capline"
  ],
  "bin": {
    "capline-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "capline": "^0.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/agnij-dutta/capline/issues"
  }
}
